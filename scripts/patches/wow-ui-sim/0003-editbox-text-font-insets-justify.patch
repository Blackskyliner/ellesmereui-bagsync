+use super::*;
+
+const EDITBOX_FONT_XML: &str = r#"
+<Ui xmlns="http://www.blizzard.com/wow/ui/">
+    <Font name="EditBoxFontProbe" virtual="true" font="Fonts\ARIALN.TTF" height="14">
+        <Color r="1.0" g="1.0" b="1.0"/>
+    </Font>
+    <EditBox name="EditBoxFontVisualTemplate" virtual="true">
+        <FontString inherits="EditBoxFontProbe"/>
+        <TextInsets left="16" right="20" bottom="0" top="0"/>
+    </EditBox>
+    <EditBox name="EditBoxFontSearchTemplate" inherits="EditBoxFontVisualTemplate" virtual="true"/>
+    <EditBox name="EditBoxFontRightTemplate" virtual="true">
+        <FontString inherits="EditBoxFontProbe" justifyH="RIGHT">
+            <Color r="0.5" g="0.25" b="0.0"/>
+        </FontString>
+    </EditBox>
+    <EditBox name="EditBoxFontXmlBox" parent="UIParent" inherits="EditBoxFontSearchTemplate" autoFocus="false"/>
+</Ui>
+"#;
+
+#[test]
+fn a_new_editbox_justifies_its_text_left() {
+    let ctx = load_test_xml("editbox-default-justify", EDITBOX_FONT_XML);
+    let justify: String = ctx
+        .env
+        .eval(r#"return CreateFrame("EditBox", nil, UIParent):GetJustifyH()"#)
+        .expect("justify probe should execute");
+    assert_eq!(justify, "LEFT");
+}
+
+#[test]
+fn an_editbox_takes_the_font_of_its_inherited_font_string_element() {
+    let ctx = load_test_xml("editbox-template-font", EDITBOX_FONT_XML);
+    let probe: (bool, bool, f64, f64, f64, String) = ctx
+        .env
+        .eval(
+            r#"
+            local runtime = CreateFrame("EditBox", nil, UIParent, "EditBoxFontSearchTemplate")
+            local r, g, b = runtime:GetTextColor()
+            return runtime:GetFontObject() == EditBoxFontProbe,
+                EditBoxFontXmlBox:GetFontObject() == EditBoxFontProbe,
+                r, g, b,
+                runtime:GetJustifyH()
+            "#,
+        )
+        .expect("template font probe should execute");
+    assert_eq!(probe, (true, true, 1.0, 1.0, 1.0, "LEFT".to_string()));
+}
+
+#[test]
+fn an_editbox_font_string_element_sets_justification_and_colour() {
+    let ctx = load_test_xml("editbox-font-attributes", EDITBOX_FONT_XML);
+    let probe: (String, f64, f64, f64) = ctx
+        .env
+        .eval(
+            r#"
+            local box = CreateFrame("EditBox", nil, UIParent, "EditBoxFontRightTemplate")
+            local r, g, b = box:GetTextColor()
+            return box:GetJustifyH(), r, g, b
+            "#,
+        )
+        .expect("font attribute probe should execute");
+    assert_eq!(probe, ("RIGHT".to_string(), 0.5, 0.25, 0.0));
+}
+
+#[test]
+fn an_editbox_takes_the_text_insets_of_its_template() {
+    let ctx = load_test_xml("editbox-template-insets", EDITBOX_FONT_XML);
+    let probe: (f64, f64, f64, f64) = ctx
+        .env
+        .eval(
+            r#"
+            local runtime = CreateFrame("EditBox", nil, UIParent, "EditBoxFontSearchTemplate")
+            local left, right = runtime:GetTextInsets()
+            local xmlLeft, xmlRight = EditBoxFontXmlBox:GetTextInsets()
+            return left, right, xmlLeft, xmlRight
+            "#,
+        )
+        .expect("text insets probe should execute");
+    assert_eq!(probe, (16.0, 20.0, 16.0, 20.0));
+}
