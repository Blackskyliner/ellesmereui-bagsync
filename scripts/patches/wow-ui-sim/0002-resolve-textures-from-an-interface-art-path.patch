Subject: [PATCH] feat: resolve Blizzard textures from WOW_SIM_INTERFACE_ART_PATH

Without a WoW install Blizzard's textures are missing. An extracted
Interface tree named by WOW_SIM_INTERFACE_ART_PATH stands in for the
install's BlizzardInterfaceArt, so machines without one, such as CI
runners, render a fixed set of textures.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
diff --git a/src/texture/resolve.rs b/src/texture/resolve.rs
index 6e1b27d64..de7579f68 100644
--- a/src/texture/resolve.rs
+++ b/src/texture/resolve.rs
@@ -27,15 +27,26 @@ fn casc_enabled() -> bool {
     })
 }
 
+/// An extracted Interface tree (`<root>/Interface/...`) named by
+/// `WOW_SIM_INTERFACE_ART_PATH` stands in for the install's: it lets machines
+/// without a WoW install, such as CI runners, render a fixed set of textures.
+fn interface_art_override() -> Option<PathBuf> {
+    std::env::var_os("WOW_SIM_INTERFACE_ART_PATH")
+        .filter(|path| !path.is_empty())
+        .map(PathBuf::from)
+}
+
 #[cfg(feature = "casc")]
 fn blizzard_interface_art_root() -> Option<PathBuf> {
-    asset_resolver::wow_install_path()
-        .and_then(|root| crate::paths::blizzard_interface_art_root_for_install_root(&root))
+    interface_art_override().or_else(|| {
+        asset_resolver::wow_install_path()
+            .and_then(|root| crate::paths::blizzard_interface_art_root_for_install_root(&root))
+    })
 }
 
 #[cfg(not(feature = "casc"))]
 fn blizzard_interface_art_root() -> Option<PathBuf> {
-    None
+    interface_art_override()
 }
 
 #[cfg(feature = "casc")]
