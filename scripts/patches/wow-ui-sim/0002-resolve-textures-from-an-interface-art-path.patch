     );
 }
 
+#[test]
+fn interface_art_path_resolves_blizzard_textures_without_an_install() {
+    let art = TempDir::new().unwrap();
+    let icons = art.path().join("interface").join("icons");
+    fs::create_dir_all(&icons).unwrap();
+    let img = image::RgbaImage::from_pixel(2, 2, image::Rgba([10, 20, 30, 255]));
+    img.save(icons.join("eui_test_icon.png")).unwrap();
+
+    // SAFETY: no other test reads WOW_SIM_INTERFACE_ART_PATH, and the
+    // directory holds only this test's file.
+    unsafe { std::env::set_var("WOW_SIM_INTERFACE_ART_PATH", art.path()) };
+    let mut mgr = TextureManager::new();
+    let with_prefix = mgr.load("Interface\\ICONS\\EUI_Test_Icon").map(|t| t.width);
+    let without_prefix = mgr.load("icons/eui_test_icon").map(|t| t.width);
+    unsafe { std::env::remove_var("WOW_SIM_INTERFACE_ART_PATH") };
+
+    assert_eq!(with_prefix, Some(2));
+    assert_eq!(without_prefix, Some(2));
+}
+
